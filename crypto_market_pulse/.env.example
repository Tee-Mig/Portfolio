# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=airflow
POSTGRES_HOST=postgres

# ── Airflow ───────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_generate_a_fernet_key
AIRFLOW_SECRET_KEY=CHANGE_ME_random_secret_string

# ── Fear & Greed Index (alternative.me — no key required) ────────────────────
# API docs: https://alternative.me/crypto/fear-and-greed-index/#api
# No configuration needed — the DAG calls it directly.

# ── CoinGecko API (free, no key required for basic endpoints) ─────────────────
# Optional: register at https://www.coingecko.com/en/api to get a free key
# and increase rate limits from ~10 to 30 calls/min
COINGECKO_API_KEY=

# ── Twitter/X API ─────────────────────────────────────────────────────────────
# NOTE: X (Twitter) API requires a paid Basic plan ($100/month) for read access.
# This project uses Reddit instead. These vars are placeholders for future use.
# TWITTER_BEARER_TOKEN=
